<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 源配置

  变更说明（本次精简重构）：
  1. 移除了 `AvaloniaCI`（https://nuget.avaloniaui.net/repository/avalonia-all/index.json）。
     该 Nexus 源已下线，返回 HTTP 521，会导致 `dotnet restore` 直接失败
     —— 即「clone 下来就构建不了」。本仓库所需的 Avalonia 相关包在 nuget.org 上均有，
     移除后已实测可完整还原。
  2. 显式加入 nuget.org，并用 <clear /> 清掉继承自机器级配置的源，
     让不同机器上的还原行为可预期、可复现。
  3. 保留 dotnet-experimental（部分预览包可能仍需要它）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet-experimental" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json" />
  </packageSources>
</configuration>
